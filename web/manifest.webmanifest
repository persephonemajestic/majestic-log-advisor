{
  "name": "Анализатор логов Majestic",
  "short_name": "Логи Majestic",
  "description": "Разбор логов Majestic RP для саппорта",
  "lang": "ru",
  "id": "/m/",
  "start_url": "/m/",
  "scope": "/m/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0F15",
  "theme_color": "#0A0F15",
  "icons": [
    { "src": "/m/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/m/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/m/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/m/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "f", "accept": ["*/*", ".log", ".txt", ".zip", ".dmp", ".evtx", "text/plain", "application/zip", "image/*"] }] }
  }
}
